MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=continuity
MINIO_ROOT_PASSWORD=continuity-local-password
CONTINUITY_BUCKET=continuity-lab
CONTINUITY_GATEWAY_URL=http://localhost:8080
CONTINUITY_GOSSIP_SECRET=local-development-secret-change-me
CONTINUITY_ALLOW_STALE_READS=false
CONTINUITY_CAS_MAX_RETRIES=16
CONTINUITY_READ_REPLICA_COUNT=3
CONTINUITY_MAX_REFS_PER_PUSH=1024
CONTINUITY_RECEIVE_MAX_INPUT_SIZE=1073741824
CONTINUITY_SNAPSHOT_ENTRY_THRESHOLD=50
CONTINUITY_SNAPSHOT_BYTE_THRESHOLD=268435456
CONTINUITY_GC_GRACE_PERIOD=1h
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
